# Copy to .env (or set these in the Netlify dashboard) before running locally.

# Public URL of the deployed site, used to build the OAuth redirect URI.
# It must end with a slash: the code appends ".netlify/functions/..." to it.
VITE_NETLIFY_APP_URL=http://localhost:3000/

# Google OAuth client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session token returned to the browser.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
